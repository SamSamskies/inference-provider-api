{
  "name": "ipa-transformers-fallback",
  "version": "0.1.0",
  "description": "Hugging Face Transformers.js compatibility backend for ipa-tools createInference fallbacks",
  "type": "module",
  "license": "MIT",
  "author": "Sam Samskies and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamSamskies/inference-provider-api.git",
    "directory": "packages/ipa-transformers-fallback"
  },
  "homepage": "https://github.com/SamSamskies/inference-provider-api/tree/main/packages/ipa-transformers-fallback",
  "bugs": {
    "url": "https://github.com/SamSamskies/inference-provider-api/issues"
  },
  "keywords": [
    "inference-provider-api",
    "ipa",
    "ipa-tools",
    "transformers.js",
    "huggingface",
    "onnx",
    "fallback"
  ],
  "files": [
    "dist"
  ],
  "exports": {
