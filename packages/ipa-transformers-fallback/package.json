    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "ipa-tools": "*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
